# =============================================================================
# VibePilot configuration. Copy to .env and fill in. NEVER commit .env.
# Generate strong secrets with:  openssl rand -hex 32
# The API refuses to start if any REQUIRED value is missing, too short, or a
# known placeholder.
# Optional settings are commented out so the built-in defaults apply: an empty
# value (VAR=) overrides the default with "", so uncomment only what you set.
# =============================================================================

# ---- Required: API secrets (apps/api) ---------------------------------------
# admin dashboard username
VP_ADMIN_USER=
# admin dashboard password (>= 12 chars)
VP_ADMIN_PASS=
# bearer token for cron/scripts (>= 32 chars)
VP_INTERNAL_API_TOKEN=
# signs user session JWTs (>= 32 chars)
JWT_SECRET=

# ---- Required: database ------------------------------------------------------
DB_NAME=vibepilot
DB_USER=vibepilot
# >= 12 chars
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
# Either set DATABASE_URL directly or let the app build it from DB_* above.
# vibepilot-backend (QR reviews service) always needs DATABASE_URL.
# DATABASE_URL=postgresql://vibepilot:<password>@db:5432/vibepilot

# ---- Optional: API behaviour -------------------------------------------------
# set false ONLY for local http development
VP_COOKIE_SECURE=true
# expose /docs and /openapi.json
VP_ENABLE_DOCS=false
# enable /auth/login-demo (development only)
VP_ENABLE_DEMO_LOGIN=false
# comma-separated allowed origins
# CORS_ORIGINS=
# trust X-Forwarded-For (only behind your own proxy)
TRUST_PROXY_HEADERS=false
POST_QUEUE_DIR=/app/post_queue
GENERATED_IMAGES_DIR=/app/generated_images
SCHEDULER_CONFIG_PATH=/app/scheduler_config.json
VP_LOG_DIR=/app/logs
VP_ADMIN_HTML_PATH=/app/static/admin_dashboard.html
VP_FORCE_RUN_STATE_PATH=/app/force_run_state.json
# where host scripts / poster load env from
VP_ENV_FILE=/etc/vibepilot/.env
# used by run_post.sh inside the container
VP_API_URL=http://127.0.0.1:8000

# ---- Business profile (demo defaults shown) ---------------------------------
BUSINESS_NAME=Sunny Side Pool Co.
BUSINESS_CITY=Sunnyvale
BUSINESS_REGION=FL
BUSINESS_LAT=28.5384
BUSINESS_LON=-81.3789
BUSINESS_HEMISPHERE=north
ENABLE_WEATHER_CONTEXT=true
# WEATHER_CITY=
# WEATHER_REGION=
# DEFAULT_CATEGORY=

# ---- AI generation (Replicate) ----------------------------------------------
# REPLICATE_API_TOKEN=
# REPLICATE_LLM=
# REPLICATE_OWNER_MODEL=
# REPLICATE_NEGATIVE=
# CAPTION_TEMP=
# IMAGE_WIDTH=
# IMAGE_HEIGHT=
# ALLOW_IMAGE_POSTS=
# REPOST_WINDOW_DAYS=
# how many times poster.py regenerates a caption that duplicates an earlier one
CAPTION_DEDUPE_ATTEMPTS=3
POST_MODE=queue
# Direct posting skips human review, so it is off unless this is true.
# VP_ALLOW_DIRECT_POST=false

# ---- Prompt-injection protection (apps/api/llm_safety.py) ---------------------
# Comma-separated domains that links in model output may point to. Empty (the
# default) removes every link and image from generated text.
# VP_OUTPUT_LINK_ALLOWLIST=
# Name of the model input that carries the system prompt. Leave empty for models
# with no such input (the instructions are then placed at the start of the prompt).
# VP_LLM_SYSTEM_PROMPT_FIELD=system_prompt

# ---- Blog generation ---------------------------------------------------------
# BLOG_CATEGORY=
# BLOG_TASK=
# BLOG_WORD_TARGET=
# BLOG_MIN_WORDS=
# BLOG_MAX_RETRIES=
# MIN_WORDS=
# POSTS_DIR=
# VIBE_POSTS_DIR=
# VIBE_LOG_DIR=
# VIBE_BLACKLIST_PATH=

# ---- Facebook / Meta Graph API ----------------------------------------------
FB_GRAPH_VERSION=v23.0
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=
# Legacy aliases still read by some modules:
# FB_PAGE_ID=
# FB_PAGE_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_PAGE_TOKEN=
# FB_TASKS=

# ---- Object storage (Storj S3 gateway) — bucket MUST be private --------------
# STORJ_S3_ENDPOINT=
# STORJ_ACCESS_KEY_ID=
# STORJ_SECRET_ACCESS_KEY=
# STORJ_BUCKET=
# STORJ_PREFIX=
STORJ_REGION=us-east-1

# ---- Telegram notifications / command bot ------------------------------------
TELEGRAM_ENABLED=0
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ALERTS_BOT_TOKEN=
# TELEGRAM_ALERTS_CHAT_ID=
# TELEGRAM_ALLOWED_USERNAMES=

# ---- Backups (scripts/backup_to_storj.sh) -----------------------------------
VP_ROOT=/opt/vibepilot
# e.g. s3://your-private-backup-bucket
# VP_BACKUP_BUCKET=
# env files are only backed up if set (encrypted)
# VP_BACKUP_GPG_RECIPIENT=

# =============================================================================
# vibepilot-backend (QR reviews service) — separate process
# =============================================================================
# REQUIRED, >= 32 chars; HMAC key for QR tokens
QR_SIGNING_SECRET=
# REQUIRED, >= 32 chars; bearer token for admin routes
VP_BACKEND_ADMIN_TOKEN=
# public URL used in QR codes and emails
# VP_PUBLIC_BASE_URL=
# optional: lets apps/api fetch AI-learning data
# VP_BACKEND_URL=
# JSON analytics store (default /tmp/...)
# VP_ANALYTICS_PATH=
# where new-review emails are sent (optional)
# REVIEW_NOTIFICATION_EMAIL=
STRIPE_LIFETIME_GROSS=0
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=

# ---- Frontends (Vite) --------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
